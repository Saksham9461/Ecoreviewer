<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-8 text-sm text-gray-600">
      <a href="/" class="hover:text-green-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/products" class="hover:text-green-600">Products</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900"><%= product.name %></span>
    </nav>

    <div class="grid md:grid-cols-2 gap-12 mb-12">
      <!-- Product Image -->
      <div>
        <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-[500px] object-cover rounded-lg shadow-lg" />
      </div>

      <!-- Product Info -->
      <div class="space-y-6">
        <div>
          <span class="inline-block px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full mb-3">
            <%= product.category %>
          </span>
          <h1 class="text-4xl font-bold mb-4"><%= product.name %></h1>
          
          <div class="flex items-center gap-2 mb-4">
            <div class="flex items-center">
              <% for(let i = 0; i < product.rating; i++) { %>
                <svg class="w-5 h-5 fill-green-600 text-green-600" viewBox="0 0 24 24">
                  <path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              <% } %>
            </div>
            <span class="text-gray-600">(<%= product.reviews %> reviews)</span>
          </div>

          <div class="text-4xl font-bold text-green-600 mb-6">$<%= product.price %></div>
        </div>

        <div class="border-t border-b border-gray-200 py-6">
          <h3 class="font-semibold mb-3">Sustainability Score</h3>
          <div class="flex items-center gap-4">
            <div class="relative w-24 h-24">
              <svg class="transform -rotate-90 w-24 h-24">
                <circle cx="48" cy="48" r="40" stroke="currentColor" stroke-width="8" fill="transparent" class="text-gray-200" />
                <circle cx="48" cy="48" r="40" stroke="currentColor" stroke-width="8" fill="transparent" 
                  stroke-dasharray="<%= 2 * Math.PI * 40 %>" 
                  stroke-dashoffset="<%= 2 * Math.PI * 40 * (1 - product.sustainabilityScore / 100) %>" 
                  class="text-green-600" />
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-2xl font-bold text-green-600"><%= product.sustainabilityScore %></span>
              </div>
            </div>
            <div>
              <p class="text-gray-600">
                This product has a high sustainability rating based on materials, manufacturing, and lifecycle impact.
              </p>
            </div>
          </div>
        </div>

        <div>
          <h3 class="font-semibold mb-3">Certifications</h3>
          <div class="flex gap-2 flex-wrap">
            <% product.certifications.forEach(cert => { %>
              <span class="px-3 py-2 bg-green-50 text-green-700 rounded-lg border border-green-200">
                <%= cert %>
              </span>
            <% }) %>
          </div>
        </div>

        <div>
          <h3 class="font-semibold mb-3">Description</h3>
          <p class="text-gray-600">
            <%= product.description %>
          </p>
        </div>

        <div class="flex gap-4">
          <a href="/reviews/add?productId=<%= product.id %>" class="flex-1 px-6 py-3 bg-green-600 text-white rounded-lg text-center hover:bg-green-700 transition-colors">
            Add Review
          </a>
          <button class="px-6 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            Share
          </button>
        </div>
      </div>
    </div>

    <!-- Reviews Section -->
    <div class="bg-white rounded-lg shadow-sm p-8">
      <h2 class="text-2xl font-bold mb-6">Customer Reviews</h2>
      
      <% if (product.userReviews && product.userReviews.length > 0) { %>
        <div class="space-y-6">
          <% product.userReviews.forEach(review => { %>
            <div class="border-b border-gray-200 pb-6 last:border-0">
              <div class="flex items-start justify-between mb-3">
                <div>
                  <h4 class="font-semibold"><%= review.userName %></h4>
                  <div class="flex items-center gap-1 mt-1">
                    <% for(let i = 0; i < review.rating; i++) { %>
                      <svg class="w-4 h-4 fill-green-600 text-green-600" viewBox="0 0 24 24">
                        <path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                      </svg>
                    <% } %>
                  </div>
                </div>
                <span class="text-sm text-gray-600"><%= review.date %></span>
              </div>
              <p class="text-gray-700"><%= review.comment %></p>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-8 text-gray-600">
          <p>No reviews yet. Be the first to review this product!</p>
          <a href="/reviews/add?productId=<%= product.id %>" class="inline-block mt-4 px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
            Write a Review
          </a>
        </div>
      <% } %>
    </div>
  </div>
</div>
