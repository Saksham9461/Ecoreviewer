<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold mb-8">Account Settings</h1>

    <% if (success) { %>
      <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg">
        <%= success %>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg">
        <%= error %>
      </div>
    <% } %>

    <!-- Profile Settings -->
    <div class="bg-white rounded-lg shadow-sm p-8 mb-6">
      <h2 class="text-xl font-semibold mb-6">Profile Information</h2>
      
      <form action="/settings/profile" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
            Full Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            value="<%= user.name %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= user.email %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          />
        </div>

        <div>
          <label for="bio" class="block text-sm font-medium text-gray-700 mb-2">
            Bio
          </label>
          <textarea
            id="bio"
            name="bio"
            rows="4"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
          ><%= user.bio || '' %></textarea>
        </div>

        <div>
          <label for="avatar" class="block text-sm font-medium text-gray-700 mb-2">
            Profile Picture
          </label>
          <input
            type="file"
            id="avatar"
            name="avatar"
            accept="image/*"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
          />
        </div>

        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
        >
          Update Profile
        </button>
      </form>
    </div>

    <!-- Password Change -->
    <div class="bg-white rounded-lg shadow-sm p-8 mb-6">
      <h2 class="text-xl font-semibold mb-6">Change Password</h2>
      
      <form action="/settings/password" method="POST" class="space-y-4">
        <div>
          <label for="currentPassword" class="block text-sm font-medium text-gray-700 mb-2">
            Current Password
          </label>
          <input
            type="password"
            id="currentPassword"
            name="currentPassword"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          />
        </div>

        <div>
          <label for="newPassword" class="block text-sm font-medium text-gray-700 mb-2">
            New Password
          </label>
          <input
            type="password"
            id="newPassword"
            name="newPassword"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          />
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
            Confirm New Password
          </label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          />
        </div>

        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
        >
          Change Password
        </button>
      </form>
    </div>

    <!-- Notification Preferences -->
    <div class="bg-white rounded-lg shadow-sm p-8 mb-6">
      <h2 class="text-xl font-semibold mb-6">Notification Preferences</h2>
      
      <form action="/settings/notifications" method="POST" class="space-y-4">
        <div class="flex items-start">
          <input
            type="checkbox"
            id="emailNotifications"
            name="emailNotifications"
            <%= user.preferences && user.preferences.emailNotifications ? 'checked' : '' %>
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="emailNotifications" class="ml-2 text-sm text-gray-700">
            Email notifications for new reviews and comments
          </label>
        </div>

        <div class="flex items-start">
          <input
            type="checkbox"
            id="productUpdates"
            name="productUpdates"
            <%= user.preferences && user.preferences.productUpdates ? 'checked' : '' %>
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="productUpdates" class="ml-2 text-sm text-gray-700">
            Updates about new eco-friendly products
          </label>
        </div>

        <div class="flex items-start">
          <input
            type="checkbox"
            id="blogUpdates"
            name="blogUpdates"
            <%= user.preferences && user.preferences.blogUpdates ? 'checked' : '' %>
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="blogUpdates" class="ml-2 text-sm text-gray-700">
            New eco stories and blog posts
          </label>
        </div>

        <div class="flex items-start">
          <input
            type="checkbox"
            id="weeklyDigest"
            name="weeklyDigest"
            <%= user.preferences && user.preferences.weeklyDigest ? 'checked' : '' %>
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="weeklyDigest" class="ml-2 text-sm text-gray-700">
            Weekly eco tips and sustainability digest
          </label>
        </div>

        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
        >
          Save Preferences
        </button>
      </form>
    </div>

    <!-- Privacy Settings -->
    <div class="bg-white rounded-lg shadow-sm p-8 mb-6">
      <h2 class="text-xl font-semibold mb-6">Privacy Settings</h2>
      
      <form action="/settings/privacy" method="POST" class="space-y-4">
        <div class="flex items-start">
          <input
            type="checkbox"
            id="publicProfile"
            name="publicProfile"
            <%= user.privacy && user.privacy.publicProfile ? 'checked' : '' %>
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="publicProfile" class="ml-2 text-sm text-gray-700">
            Make my profile public
          </label>
        </div>

        <div class="flex items-start">
          <input
            type="checkbox"
            id="showReviews"
            name="showReviews"
            <%= user.privacy && user.privacy.showReviews !== false ? 'checked' : '' %>
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="showReviews" class="ml-2 text-sm text-gray-700">
            Show my reviews publicly
          </label>
        </div>

        <div class="flex items-start">
          <input
            type="checkbox"
            id="showEcoScore"
            name="showEcoScore"
            <%= user.privacy && user.privacy.showEcoScore !== false ? 'checked' : '' %>
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="showEcoScore" class="ml-2 text-sm text-gray-700">
            Display my eco score on profile
          </label>
        </div>

        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
        >
          Save Privacy Settings
        </button>
      </form>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white rounded-lg shadow-sm p-8 border-2 border-red-200">
      <h2 class="text-xl font-semibold text-red-600 mb-6">Danger Zone</h2>
      
      <div class="space-y-4">
        <div class="flex items-center justify-between p-4 bg-red-50 rounded-lg">
          <div>
            <h3 class="font-medium text-gray-900">Delete Account</h3>
            <p class="text-sm text-gray-600">Permanently delete your account and all associated data</p>
          </div>
          <form action="/settings/delete-account" method="POST" onsubmit="return confirm('Are you sure you want to delete your account? This action cannot be undone.');">
            <button
              type="submit"
              class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
            >
              Delete Account
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
