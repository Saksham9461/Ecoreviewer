<div class="min-h-screen">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-green-50 via-green-100 to-yellow-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 bg-white rounded-full px-4 py-2 shadow-sm">
            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <span class="text-sm text-gray-600">Sustainable Living Platform</span>
          </div>
          <h1 class="text-5xl md:text-6xl font-bold text-gray-900">
            Review Green,<br />Inspire Clean
          </h1>
          <p class="text-xl text-gray-600">
            Discover, review, and share eco-friendly products that make a difference. Join our community of conscious consumers.
          </p>
          <div class="flex gap-4">
            <a href="/products" class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
              Explore Products
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a href="/blog" class="px-6 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
              Share Your Story
            </a>
          </div>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-green-300/20 rounded-full blur-3xl"></div>
          <img src="https://images.unsplash.com/photo-1625409588021-8c8a6ad82d99?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxuYXR1cmUlMjBncmVlbiUyMGxlYXZlc3xlbnwxfHx8fDE3NjA0NTEyNjN8MA&ixlib=rb-4.1.0&q=80&w=1080" alt="Eco friendly" class="relative rounded-2xl shadow-2xl w-full h-96 object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-12 bg-white border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-green-50 rounded-full mb-3">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <div class="text-3xl font-bold text-gray-900">10K+</div>
          <div class="text-sm text-gray-600">Eco Products</div>
        </div>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-green-50 rounded-full mb-3">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <div class="text-3xl font-bold text-gray-900">50K+</div>
          <div class="text-sm text-gray-600">Reviews</div>
        </div>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-green-50 rounded-full mb-3">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <div class="text-3xl font-bold text-gray-900">5K+</div>
          <div class="text-sm text-gray-600">Active Users</div>
        </div>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-green-50 rounded-full mb-3">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <div class="text-3xl font-bold text-gray-900">95%</div>
          <div class="text-sm text-gray-600">Satisfaction</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Featured Eco Products</h2>
          <p class="text-gray-600 mt-2">Discover top-rated sustainable products</p>
        </div>
        <a href="/products" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg hover:bg-white transition-colors">
          View All
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% featuredProducts.forEach(product => { %>
          <div class="bg-white rounded-lg shadow-sm overflow-hidden hover:shadow-lg transition-shadow cursor-pointer">
            <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-48 object-cover" />
            <div class="p-4">
              <h3 class="font-semibold mb-2"><%= product.name %></h3>
              <div class="flex items-center gap-1 mb-2">
                <% for(let i = 0; i < product.rating; i++) { %>
                  <svg class="w-4 h-4 fill-green-600 text-green-600" viewBox="0 0 24 24">
                    <path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                <% } %>
                <span class="text-sm text-gray-600 ml-1">(<%= product.reviews %>)</span>
              </div>
              <div class="flex gap-2 mb-3">
                <% product.certifications.forEach(cert => { %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded"><%= cert %></span>
                <% }) %>
              </div>
              <div class="text-lg font-semibold text-green-600">$<%= product.price %></div>
            </div>
            <div class="p-4 pt-0">
              <a href="/products/<%= product.id %>" class="block w-full text-center px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                View Details
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-green-600 text-white">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 rounded-full mb-6">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      <h2 class="text-4xl font-bold mb-4">Join the Green Revolution</h2>
      <p class="text-xl opacity-90 mb-8">
        Share your eco journey, inspire others, and make a positive impact on our planet
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/signup" class="px-6 py-3 bg-white text-green-600 rounded-lg hover:bg-gray-100 transition-colors">
          Get Started Free
        </a>
        <a href="/about" class="px-6 py-3 border border-white rounded-lg hover:bg-white/10 transition-colors">
          Learn More
        </a>
      </div>
    </div>
  </section>
</div>
