<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-4xl font-bold mb-2">Eco Stories & Blog</h1>
        <p class="text-gray-600">Get inspired by our community's sustainable journey</p>
      </div>
      <% if (isLoggedIn) { %>
        <a href="/blog/create" class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
          Share Your Story
        </a>
      <% } %>
    </div>

    <!-- Featured Story -->
    <% if (featuredStory) { %>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-12">
        <div class="grid md:grid-cols-2 gap-0">
          <img src="<%= featuredStory.image %>" alt="<%= featuredStory.title %>" class="w-full h-96 object-cover" />
          <div class="p-8 flex flex-col justify-center">
            <span class="inline-block px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full mb-3 w-fit">
              Featured Story
            </span>
            <h2 class="text-3xl font-bold mb-4"><%= featuredStory.title %></h2>
            <p class="text-gray-600 mb-4"><%= featuredStory.excerpt %></p>
            <div class="flex items-center justify-between text-sm text-gray-600 mb-6">
              <span>By <%= featuredStory.author %></span>
              <span><%= featuredStory.readTime %></span>
            </div>
            <a href="/blog/<%= featuredStory.id %>" class="inline-block px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors w-fit">
              Read More
            </a>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Categories -->
    <div class="flex gap-3 mb-8 overflow-x-auto pb-2">
      <a href="/blog" class="px-4 py-2 <%= !category ? 'bg-green-600 text-white' : 'bg-white text-gray-700' %> rounded-lg whitespace-nowrap hover:bg-green-500 hover:text-white transition-colors">
        All Stories
      </a>
      <% categories.forEach(cat => { %>
        <a href="/blog?category=<%= cat %>" class="px-4 py-2 <%= category === cat ? 'bg-green-600 text-white' : 'bg-white text-gray-700' %> rounded-lg whitespace-nowrap hover:bg-green-500 hover:text-white transition-colors">
          <%= cat %>
        </a>
      <% }) %>
    </div>

    <!-- Stories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% stories.forEach(story => { %>
        <div class="bg-white rounded-lg shadow-sm overflow-hidden hover:shadow-lg transition-shadow">
          <a href="/blog/<%= story.id %>">
            <img src="<%= story.image %>" alt="<%= story.title %>" class="w-full h-48 object-cover" />
          </a>
          <div class="p-6">
            <span class="inline-block px-2 py-1 bg-green-100 text-green-800 text-xs rounded mb-3">
              <%= story.category %>
            </span>
            <h3 class="font-semibold mb-3">
              <a href="/blog/<%= story.id %>" class="hover:text-green-600">
                <%= story.title %>
              </a>
            </h3>
            <div class="flex items-center justify-between text-sm text-gray-600">
              <span><%= story.author %></span>
              <span><%= story.readTime %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (stories.length === 0) { %>
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h3 class="text-xl font-semibold mb-2">No stories yet</h3>
        <p class="text-gray-600">Be the first to share your eco journey!</p>
      </div>
    <% } %>
  </div>
</div>
