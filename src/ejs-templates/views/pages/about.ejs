<div class="min-h-screen">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-green-50 via-green-100 to-yellow-50 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-bold mb-6">About ECO REVIEWER</h1>
      <p class="text-xl text-gray-700">
        Building a community of conscious consumers who care about our planet
      </p>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-6">Our Mission</h2>
          <p class="text-gray-700 mb-4">
            At ECO REVIEWER, we believe that every purchase decision can make a positive impact on our planet. Our mission is to empower consumers with transparent, reliable information about eco-friendly products.
          </p>
          <p class="text-gray-700 mb-4">
            We've created a platform where sustainability meets community, where real people share real experiences with products that prioritize our planet's health.
          </p>
          <p class="text-gray-700">
            Together, we're building a future where sustainable choices are the norm, not the exception.
          </p>
        </div>
        <img 
          src="https://images.unsplash.com/photo-1625409588021-8c8a6ad82d99?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxuYXR1cmUlMjBncmVlbiUyMGxlYXZlc3xlbnwxfHx8fDE3NjA0NTEyNjN8MA&ixlib=rb-4.1.0&q=80&w=1080" 
          alt="Our Mission" 
          class="rounded-lg shadow-lg w-full h-80 object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">Our Values</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-lg shadow-sm">
          <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Transparency</h3>
          <p class="text-gray-600">
            We believe in honest, authentic reviews from real users. No hidden agendas, just genuine experiences.
          </p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm">
          <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Sustainability</h3>
          <p class="text-gray-600">
            Environmental responsibility is at the core of everything we do and every product we feature.
          </p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm">
          <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Community</h3>
          <p class="text-gray-600">
            Together we're stronger. We foster a supportive community of like-minded individuals.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">Our Team</h2>
      <div class="grid md:grid-cols-4 gap-8">
        <% ['Sarah Green', 'Michael Chen', 'Emma Wilson', 'David Park'].forEach((name, i) => { %>
          <div class="text-center">
            <div class="w-32 h-32 bg-green-600 rounded-full mx-auto mb-4 flex items-center justify-center text-white text-3xl font-semibold">
              <%= name.charAt(0) %>
            </div>
            <h3 class="font-semibold mb-1"><%= name %></h3>
            <p class="text-sm text-gray-600">
              <%= ['Founder & CEO', 'Head of Community', 'Product Director', 'Tech Lead'][i] %>
            </p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-green-600 text-white">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold mb-4">Join Our Mission</h2>
      <p class="text-xl opacity-90 mb-8">
        Be part of the change you want to see in the world
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/signup" class="px-6 py-3 bg-white text-green-600 rounded-lg hover:bg-gray-100 transition-colors">
          Get Started
        </a>
        <a href="/contact" class="px-6 py-3 border border-white rounded-lg hover:bg-white/10 transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</div>
