<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-lg shadow-sm p-8">
      <h1 class="text-3xl font-bold mb-2">Write a Review</h1>
      <p class="text-gray-600 mb-8">Share your experience with eco-friendly products</p>

      <% if (error) { %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg">
          <%= error %>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg">
          <%= success %>
        </div>
      <% } %>

      <form action="/reviews/add" method="POST" enctype="multipart/form-data" class="space-y-6">
        <!-- Product Selection -->
        <div>
          <label for="productId" class="block text-sm font-medium text-gray-700 mb-2">
            Select Product
          </label>
          <select
            id="productId"
            name="productId"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          >
            <option value="">Choose a product...</option>
            <% products.forEach(product => { %>
              <option value="<%= product.id %>" <%= selectedProductId == product.id ? 'selected' : '' %>>
                <%= product.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Rating -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3">
            Eco Rating (Leaves)
          </label>
          <div class="flex gap-2">
            <% for(let i = 1; i <= 5; i++) { %>
              <input
                type="radio"
                id="rating-<%= i %>"
                name="rating"
                value="<%= i %>"
                class="hidden peer/<%= i %>"
                required
              />
              <label
                for="rating-<%= i %>"
                class="cursor-pointer p-3 border-2 border-gray-300 rounded-lg hover:border-green-600 peer-checked/<%= i %>:border-green-600 peer-checked/<%= i %>:bg-green-50 transition-all"
              >
                <div class="flex items-center gap-1">
                  <% for(let j = 0; j < i; j++) { %>
                    <svg class="w-5 h-5 fill-green-600 text-green-600" viewBox="0 0 24 24">
                      <path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                  <% } %>
                </div>
              </label>
            <% } %>
          </div>
        </div>

        <!-- Review Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
            Review Title
          </label>
          <input
            type="text"
            id="title"
            name="title"
            placeholder="Summarize your experience"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          />
        </div>

        <!-- Review Content -->
        <div>
          <label for="content" class="block text-sm font-medium text-gray-700 mb-2">
            Your Review
          </label>
          <textarea
            id="content"
            name="content"
            rows="6"
            placeholder="Tell us about your experience with this product..."
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
            required
          ></textarea>
        </div>

        <!-- Pros -->
        <div>
          <label for="pros" class="block text-sm font-medium text-gray-700 mb-2">
            Pros (Optional)
          </label>
          <textarea
            id="pros"
            name="pros"
            rows="3"
            placeholder="What did you like about this product?"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
          ></textarea>
        </div>

        <!-- Cons -->
        <div>
          <label for="cons" class="block text-sm font-medium text-gray-700 mb-2">
            Cons (Optional)
          </label>
          <textarea
            id="cons"
            name="cons"
            rows="3"
            placeholder="What could be improved?"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
          ></textarea>
        </div>

        <!-- Upload Photos -->
        <div>
          <label for="photos" class="block text-sm font-medium text-gray-700 mb-2">
            Upload Photos (Optional)
          </label>
          <input
            type="file"
            id="photos"
            name="photos"
            multiple
            accept="image/*"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
          />
          <p class="text-sm text-gray-500 mt-1">You can upload up to 5 photos</p>
        </div>

        <!-- Would Recommend -->
        <div class="flex items-start">
          <input
            type="checkbox"
            id="recommend"
            name="recommend"
            value="true"
            class="mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500"
          />
          <label for="recommend" class="ml-2 text-sm text-gray-700">
            I would recommend this product to others
          </label>
        </div>

        <!-- Submit Buttons -->
        <div class="flex gap-4">
          <button
            type="submit"
            class="flex-1 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
          >
            Submit Review
          </button>
          <a
            href="/products"
            class="px-6 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
          >
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
