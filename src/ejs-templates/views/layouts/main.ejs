<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'ECO REVIEWER - Review Green, Inspire Clean' %></title>
  <link rel="stylesheet" href="/styles/globals.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Custom Tailwind configuration for eco theme */
    :root {
      --color-primary: hsl(142 76% 36%);
      --color-primary-foreground: hsl(0 0% 100%);
      --color-secondary: hsl(45 93% 47%);
      --color-secondary-foreground: hsl(0 0% 0%);
      --color-accent: hsl(142 33% 96%);
      --color-accent-foreground: hsl(142 76% 36%);
      --color-background: hsl(0 0% 100%);
      --color-foreground: hsl(0 0% 10%);
      --color-muted: hsl(210 40% 96%);
      --color-muted-foreground: hsl(0 0% 45%);
      --color-border: hsl(214 32% 91%);
      --color-card: hsl(0 0% 100%);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <% if (showNavbar !== false) { %>
    <%- include('../partials/navbar', { currentPage, isLoggedIn, user }) %>
  <% } %>
  
  <main class="flex-1">
    <%- body %>
  </main>
  
  <% if (showFooter !== false) { %>
    <%- include('../partials/footer') %>
  <% } %>
  
  <script src="/js/main.js"></script>
</body>
</html>
